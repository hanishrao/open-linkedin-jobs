{
  "name": "open-linkedin-jobs",
  "version": "1.0.0",
  "description": "A robust, type-safe, and zero-config Node.js scraper for fetching LinkedIn job listings with built-in rate limiting and TypeScript support.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "open-linkedin-jobs": "./dist/cli.js"
  },
  "scripts": {
    "test": "node test.js",
    "test:unit": "vitest run",
    "build": "tsc",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyraze/open-linkedin-jobs.git"
  },
  "keywords": [
    "linkedin",
    "linkedin-jobs",
    "jobs",
    "linkedin-jobs-api",
    "linkedin-api",
    "api",
    "scraper",
    "crawler",
    "job-scraper",
    "job-board",
    "typescript",
    "automation",
    "node",
    "cheerio"
  ],
  "author": "Hanish Rao",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/Hyraze/open-linkedin-jobs/issues"
  },
  "homepage": "https://github.com/Hyraze/open-linkedin-jobs#readme",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^14.0.2",
    "https-proxy-agent": "^7.0.6",
    "user-agents": "^1.1.669"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^25.0.9",
    "@types/user-agents": "^1.0.4",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.17"
  }
}
